APP_NAME="USB CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/crm
MASKING_SECRET_KEY=your-masking-secret-key
MASKING_SECRET_IV=your-masking-secret-iv
MAIL_VERIFY_PEER=true
LOG_CHANNEL=stack
LOG_LEVEL=error
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_LOG_REQUEST_METRICS=true
SLOW_QUERY_THRESHOLD_MS=250
SLOW_REQUEST_THRESHOLD_MS=1000
TRACK_MIN_REQUEST_MS=50
QUEUE_CONNECTION=database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


# WhatsApp OTP Configuration (bhashsms.com)
WHATSAPP_DRIVER=bhashsms
WHATSAPP_API_URL=http://bhashsms.com/api/sendmsgutil.php
WHATSAPP_API_USER=your-whatsapp-api-user
WHATSAPP_API_PASS=your-whatsapp-api-password
WHATSAPP_API_SENDER=your-sender-id
WHATSAPP_API_TIMEOUT=25
WHATSAPP_OTP_TEMPLATE_NAME=auth_uniq
WHATSAPP_TASK_SUMMARY_TIME=09:00
LEAD_FOLLOWUP_SUMMARY_ENABLED=true
LEAD_FOLLOWUP_SUMMARY_TIME=09:00
