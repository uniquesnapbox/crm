PORT=3100
NODE_ENV=production
WHATSAPP_API_KEY=change-me
WHATSAPP_INBOUND_WEBHOOK_URL=https://crm.example.com/api/internal/whatsapp/incoming
WHATSAPP_INBOUND_WEBHOOK_TOKEN=change-me-too
# Supports: "*", single origin, comma-separated origins, or JSON array of origins
# Example: ["http://localhost:8000","http://192.168.1.50:8000","https://app.example.com"]
WHATSAPP_SOCKET_CORS_ORIGIN=*
WHATSAPP_SOCKET_ALLOW_NO_ORIGIN=true
WHATSAPP_SOCKET_PATH=/socket.io
WHATSAPP_SOCKET_PING_INTERVAL_MS=25000
WHATSAPP_SOCKET_PING_TIMEOUT_MS=60000
WHATSAPP_SOCKET_CONNECT_TIMEOUT_MS=45000
WHATSAPP_SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
WHATSAPP_SOCKET_RECOVERY_DURATION_MS=120000
WHATSAPP_RECONNECT_BASE_DELAY_MS=5000
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000
WHATSAPP_DEFAULT_SESSION=default
WHATSAPP_SESSIONS=["default"]
WHATSAPP_DATA_PATH=./.wwebjs_auth
WHATSAPP_HEADLESS=true
WHATSAPP_WEB_VERSION_CACHE_STRICT=false
